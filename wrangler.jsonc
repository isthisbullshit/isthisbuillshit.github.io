{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "isthisbuillshit",
  "main": "./worker.mjs",
  "compatibility_date": "2026-05-22",
  "services": [
    {
      "binding": "BACKEND",
      "service": "isthisbullshit-backend"
    }
  ],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
